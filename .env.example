# Copia este archivo a .env y cambia los valores. .env no se versiona.

# --- Aplicación ---
# Cadena de conexión SQLAlchemy a PostgreSQL (driver psycopg 3). Dentro de compose el host es "db".
# Usuario, clave y base deben coincidir con las POSTGRES_* de abajo.
DATABASE_URL=postgresql+psycopg://notif:cambiar_clave@db:5432/notificaciones
# Nivel de log: DEBUG, INFO, WARNING o ERROR.
LOG_LEVEL=INFO

# Cola de mensajes. En compose el host es "rabbitmq" (amqp://); en producción va la URL
# amqps:// de CloudAMQP. Sin valor, la API arranca pero no puede publicar.
AMQP_URL=amqp://notif:cambiar_clave@rabbitmq:5672/
# Segundos máximos para conectar y para que el broker confirme cada publicación.
AMQP_TIMEOUT_S=5

# Segundos entre ciclos del planificador (cierra alertas vencidas y reintenta publicaciones).
CICLO_INTERVALO_S=300

# --- Solo producción (docker-compose.prod.yml) ---
# Nombre público de la API, apuntando a la IP del servidor, con los puertos 80 y 443 abiertos.
# Caddy le pide su certificado HTTPS. Ejemplo: DOMINIO=13-59-144-83.sslip.io
# En pruebas locales: DOMINIO=localhost (certificado local) y HTTP_PORT / HTTPS_PORT libres.
# DOMINIO=
# HTTP_PORT=80
# HTTPS_PORT=443

# --- Solo docker-compose ---
# Usuario, clave y base que crea el contenedor de PostgreSQL.
POSTGRES_USER=notif
POSTGRES_PASSWORD=cambiar_clave
POSTGRES_DB=notificaciones
# Puerto del host donde se publica el RabbitMQ local (solo 127.0.0.1; lo usa el demo).
RABBITMQ_PORT=5672
# Usuario y clave del RabbitMQ local; deben coincidir con AMQP_URL.
RABBITMQ_DEFAULT_USER=notif
RABBITMQ_DEFAULT_PASS=cambiar_clave
# Puerto del host donde se publica la API (dentro del contenedor siempre es el 8000).
API_PORT=8090
# Solo docker-compose.prod.yml (EC2): imagen publicada por el CI. cd.yml la reemplaza por el tag del commit.
# API_IMAGE=<usuario_dockerhub>/notificaciones:main
