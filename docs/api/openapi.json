            "title": "Productoid"
          },
          "stockActual": {
            "description": "Existencia actual",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Stockactual",
            "type": "integer"
          },
          "stockMinimo": {
            "description": "Mínimo establecido",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Stockminimo",
            "type": "integer"
          },
          "tipo": {
            "$ref": "#/components/schemas/TipoStockBajo",
